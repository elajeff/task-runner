# Default provider: Gemini. Create a key at https://aistudio.google.com/apikey.
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional native OpenAI API provider (API access is billed separately from ChatGPT).
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-sol

# Optional native Anthropic Claude API provider (API access is billed separately from Claude.ai).
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional local Ollama server. Install Ollama and pull a model separately.
# AGENT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# Optional compatible API server, such as LM Studio or a hosted compatible service.
# For hosted services, provide an API key and server address.
# For local servers without authentication, a loopback URL can omit the key.
# AGENT_PROVIDER=openai_compatible
# COMPAT_BASE_URL=http://localhost:1234/v1
# COMPAT_API_KEY=
# COMPAT_MODEL=
# COMPAT_JSON_MODE=true

# Runtime settings (paths are relative to the project root unless absolute).
AGENT_WORKSPACE=workspace
AGENT_DATABASE=data/runtime.db
AGENT_MAX_STEPS=8
